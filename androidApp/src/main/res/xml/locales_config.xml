<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the system's per-app language picker offers for Loopky (Settings → Apps → Loopky →
  Language). Written by hand rather than generated by `androidResources.generateLocaleConfig`, so
  the list is reviewable in the diff that adds a translation.

  Must stay in step with `AppLocale.SUPPORTED` and with the `res/values-…` directories — nothing
  checks the three against each other, and a locale missing here simply never appears in the
  system picker.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android"
    android:defaultLocale="en">
    <locale android:name="en" />
    <locale android:name="pt-BR" />
</locale-config>
