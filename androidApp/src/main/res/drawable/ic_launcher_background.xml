<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: Loopky's warm surface ramp. Light rather than accent orange, because
  the fox itself is orange and would disappear into the brand colour. Full-bleed so every
  launcher mask (circle, squircle, rounded square) crops into solid colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFFBF5"
                android:endColor="#FFE8D6" />
        </aapt:attr>
    </path>
</vector>
