<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android plural rules. Every count-bearing string lives here: the app previously wrote
      "1 cards", "1 decks" and so on because every count string was a plain %1$d format.
    -->
    <plurals name="duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="duration_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="duration_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="card_count">
        <item quantity="one">%1$d card</item>
        <item quantity="other">%1$d cards</item>
    </plurals>
    <plurals name="cards_ready">
        <item quantity="one">%1$d card ready</item>
        <item quantity="other">%1$d cards ready</item>
    </plurals>
    <plurals name="cards_discarded">
        <item quantity="one">%1$d discarded in review</item>
        <item quantity="other">%1$d discarded in review</item>
    </plurals>
    <plurals name="cards_published">
        <item quantity="one">%1$d card is now public.</item>
        <item quantity="other">%1$d cards are now public.</item>
    </plurals>
    <plurals name="study_goal_reached_count">
        <item quantity="one">%1$d new card today</item>
        <item quantity="other">%1$d new cards today</item>
    </plurals>
    <plurals name="cards_reviewed">
        <item quantity="one">You reviewed %1$d card.</item>
        <item quantity="other">You reviewed %1$d cards.</item>
    </plurals>
    <plurals name="cards_incomplete">
        <item quantity="one">%1$d incomplete</item>
        <item quantity="other">%1$d incomplete</item>
    </plurals>
    <plurals name="public_decks_count">
        <item quantity="one">Public deck · %1$d</item>
        <item quantity="other">Public decks · %1$d</item>
    </plurals>
    <!-- A profile's grid mixes decks they wrote with decks they follow, so it is not "public
         decks of theirs" any more — the author caption under each tile says whose it is. -->
    <plurals name="profile_decks_count">
        <item quantity="one">All decks · %1$d</item>
        <item quantity="other">All decks · %1$d</item>
    </plurals>
    <plurals name="bulk_cards_parsed">
        <item quantity="one">%1$d card parsed</item>
        <item quantity="other">%1$d cards parsed</item>
    </plurals>
    <plurals name="bulk_import_cards">
        <item quantity="one">Import %1$d card</item>
        <item quantity="other">Import %1$d cards</item>
    </plurals>
    <plurals name="bulk_duplicates">
        <item quantity="one">%1$d duplicate merged</item>
        <item quantity="other">%1$d duplicates merged</item>
    </plurals>
    <plurals name="bulk_truncated">
        <item quantity="one">%1$d row past the limit was not imported</item>
        <item quantity="other">%1$d rows past the limit were not imported</item>
    </plurals>
    <plurals name="bulk_dropped_notes">
        <item quantity="one">%1$d note had no front and back to use</item>
        <item quantity="other">%1$d notes had no front and back to use</item>
    </plurals>
    <plurals name="bulk_images_skipped">
        <item quantity="one">%1$d picture past the limit was not imported</item>
        <item quantity="other">%1$d pictures past the limit were not imported</item>
    </plurals>
    <plurals name="deck_detail_clones">
        <item quantity="one">%1$d clone</item>
        <item quantity="other">%1$d clones</item>
    </plurals>
    <!-- The plural agrees with the *card* count, so the quantity argument is %2$d. -->
    <plurals name="home_deck_due_cards">
        <item quantity="one">%1$d due · %2$d card</item>
        <item quantity="other">%1$d due · %2$d cards</item>
    </plurals>
    <plurals name="home_deck_new_cards">
        <item quantity="one">%1$d new · %2$d card</item>
        <item quantity="other">%1$d new · %2$d cards</item>
    </plurals>
    <!-- Short on purpose: a paragraph here is a paragraph nobody reads. -->
    <plurals name="deck_detail_clone_dialog_message">
        <item quantity="one">You\'ll own an editable copy of this %1$d card. It won\'t get the author\'s updates, and your progress starts over.</item>
        <item quantity="other">You\'ll own an editable copy of all %1$d cards. It won\'t get the author\'s updates, and your progress starts over.</item>
    </plurals>
    <plurals name="publish_progress_count">
        <item quantity="one">Publishing %1$d of %2$d card…</item>
        <item quantity="other">Publishing %1$d of %2$d cards…</item>
    </plurals>
    <plurals name="cards_tried">
        <item quantity="one">You tried %1$d card.</item>
        <item quantity="other">You tried %1$d cards.</item>
    </plurals>
</resources>
