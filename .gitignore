*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Build outputs. The release skill drops a renamed, signed APK in the repo root
# (Loopky-<version>.apk) before uploading it to the GitHub release.
*.apk
*.aab

# Keystore files — signing material never belongs in the repo. The keystore path and its
# passwords are configured in local.properties (gitignored above).
*.jks
*.keystore

# App Store asset staging (large videos; screenshots are mirrored in screenshots/ios-*)
appstore/

# Play Store listing asset staging. Generated from the launcher icon and brand palette rather
# than authored by hand, so they are reproducible and not worth versioning: play/icon-512.png
# is the adaptive icon composited flat, play/feature-1024x500.png the same lockup at 1024x500.
play/

# Personal Claude Code permissions — per-developer, not project config.
.claude/settings.json

# `claude plugin eval` writes its reports beside the cases.
plugins/*/evals/results/

# Per-developer iOS signing (TEAM_ID); see iosApp/Configuration/Config.xcconfig
iosApp/Configuration/Local.xcconfig
