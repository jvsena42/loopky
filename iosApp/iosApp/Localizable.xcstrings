    "bulk_error_legacy_stub_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält nur den Kompatibilitäts-Platzhalter von Anki. Exportiere den Stapel erneut aus Anki 2.1.50 oder neuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file only holds Anki's compatibility placeholder. Re-export the deck from Anki 2.1.50 or newer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo solo contiene el marcador de compatibilidad de Anki. Vuelve a exportar el mazo desde Anki 2.1.50 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ne contient que l’espace réservé de compatibilité d’Anki. Réexporte le paquet depuis Anki 2.1.50 ou plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file contiene solo il segnaposto di compatibilità di Anki. Esporta di nuovo il mazzo da Anki 2.1.50 o successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには Anki の互換性用プレースホルダーしか入っていません。Anki 2.1.50 以降でデッキをエクスポートし直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 Anki의 호환용 자리 표시자만 들어 있어요. Anki 2.1.50 이상에서 덱을 다시 내보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo só contém o marcador de compatibilidade do Anki. Reexporte o baralho a partir do Anki 2.1.50 ou mais novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp chỉ chứa phần giữ chỗ tương thích của Anki. Hãy xuất lại bộ thẻ từ Anki 2.1.50 trở lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件只包含 Anki 的兼容性占位内容。请用 Anki 2.1.50 或更新版本重新导出卡组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案只包含 Anki 的相容性預留內容。請從 Anki 2.1.50 或更新版本重新匯出牌組。"
          }
        }
      }
    },
