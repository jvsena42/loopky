    "onboarding_hero_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilte Wiederholung, die sich wie ein Spiel anfühlt. Stapel, die du erstellst, teilst und von Freunden lernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaced repetition that feels like a game. Decks you make, share, and learn from friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetición espaciada que se siente como un juego. Mazos que creas, compartes y aprendes con amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La répétition espacée qui ressemble à un jeu. Des paquets à créer, à partager et à apprendre entre amis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizione dilazionata che sembra un gioco. Mazzi da creare, condividere e imparare dagli amici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム感覚で続けられる間隔反復。デッキを作って、共有して、友だちのデッキで学べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임처럼 즐기는 간격 반복 학습. 직접 만들고, 공유하고, 친구의 덱으로 배워요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetição espaçada com cara de jogo. Baralhos que você cria, compartilha e aprende com amigos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại ngắt quãng mà vui như chơi game. Bộ thẻ do bạn tạo, chia sẻ và học cùng bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像玩游戏一样的间隔重复。自己制作卡组、分享卡组，也能用朋友的卡组学习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像遊戲一樣的間隔重複。自己製作、分享牌組，也向朋友的牌組學習。"
          }
        }
      }
    },
    "onboarding_no_email_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine E-Mail. Kein Passwort. Dein Schlüssel, dein Konto."
