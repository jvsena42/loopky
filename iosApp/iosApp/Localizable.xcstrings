    "bulk_fields_sheet_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki-Stapel beginnen oft mit ID- oder Ranking-Feldern. Wähle die beiden, die du lernen willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki decks often start with id or ranking fields. Pick the two you want to study."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mazos de Anki suelen empezar con campos de id o de ranking. Elige los dos que quieres estudiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets Anki commencent souvent par des champs d’identifiant ou de classement. Choisis les deux que tu veux étudier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mazzi Anki spesso iniziano con campi di id o di classifica. Scegli i due che vuoi studiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki のデッキは ID や順位のフィールドから始まることがよくあります。学習したい2つを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 덱은 ID나 순위 필드로 시작하는 경우가 많아요. 학습할 두 필드를 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baralhos do Anki costumam começar com campos de id ou ranking. Escolha os dois que você quer estudar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ Anki thường bắt đầu bằng các trường mã số hoặc thứ hạng. Hãy chọn hai trường bạn muốn học."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 卡组通常以 ID 或排名字段开头。选出你想学习的两个字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki 牌組常常以 ID 或排名欄位開頭。選出你想學習的兩個欄位。"
          }
        }
      }
    },
