    "signup_lightning_resumed_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht hast du ₿ %1$lld schon bezahlt. Warte, während wir das bestätigen, und zahle nicht noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may already have paid ₿ %1$lld. Hold on while we confirm, and don't pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que ya hayas pagado ₿ %1$lld. Espera mientras lo confirmamos, y no vuelvas a pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as peut-être déjà payé ₿ %1$lld. Patiente pendant qu’on confirme, et ne paie pas une deuxième fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti aver già pagato ₿ %1$lld. Attendi mentre confermiamo e non pagare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "₿ %1$lld はすでに支払い済みかもしれません。確認が終わるまでお待ちください。もう一度支払わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 ₿ %1$lld을(를) 결제했을 수 있어요. 확인하는 동안 기다려 주시고, 다시 결제하지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode já ter pago ₿ %1$lld. Aguarde enquanto confirmamos, e não pague de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể bạn đã trả ₿ %1$lld. Vui lòng chờ chúng tôi xác nhận và đừng trả lại lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可能已经支付了 ₿ %1$lld。请稍候，我们正在确认，请不要重复付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可能已經支付了 ₿ %1$lld。我們正在確認，請稍候，不要重複付款。"
          }
        }
      }
    },
