    "sign_in_prompt_clone_deck_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie gehört dir: veröffentlicht unter deinem Schlüssel und von dir bearbeitbar. Dafür brauchst du ein Konto, aber keine E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clone is your own copy, published under your key and yours to edit. It needs an account, but no email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia es tuya: se publica con tu clave y puedes editarla. Necesitas una cuenta, pero no un correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie t’appartient : publiée avec ta clé, et c’est toi qui la modifies. Il faut un compte, mais pas d’e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia è tutta tua: pubblicata con la tua chiave e modificabile da te. Serve un account, ma nessuna email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia é sua, publicada sob a sua chave e sua para editar. Precisa de uma conta, mas não de e-mail."
          }
        }
      }
    },
