        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un archivo protegido con contraseña en Archivos o en iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un fichier protégé par mot de passe dans Fichiers ou iCloud Drive."
