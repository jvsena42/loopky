    "restore_error_invalid_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob alle zwölf Wörter richtig geschrieben sind und in der richtigen Reihenfolge stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that all twelve words are spelled correctly and in the right order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que las doce palabras estén bien escritas y en el orden correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que les douze mots sont bien orthographiés et dans le bon ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla che tutte e dodici le parole siano scritte correttamente e nell'ordine giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12個の単語のつづりと順番がすべて正しいか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12개의 단어가 모두 정확한 철자로 올바른 순서대로 입력됐는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se as doze palavras estão escritas corretamente e na ordem certa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra cả mười hai từ đều viết đúng chính tả và đúng thứ tự."
