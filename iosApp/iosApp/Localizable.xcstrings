            "value": "Un mot mal saisi ou dans le désordre passe quand même la vérification et déverrouille un autre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola scritta male o fuori ordine supera comunque il controllo e sblocca un account diverso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra digitada errada ou fora de ordem ainda passa na verificação e desbloqueia outra conta."
          }
        }
      }
    },
