    "backup_phrase_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Phrase gilt nur für dein Konto. Sie ist keine Bitcoin-Wallet und enthält kein Guthaben."
