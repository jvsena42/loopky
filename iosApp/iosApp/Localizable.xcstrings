    "settings_sign_out_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stapel bleiben in deinem Konto. Wenn du dich wieder anmeldest, ist alles wieder da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your decks stay in your account. Signing back in restores everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mazos se quedan en tu cuenta. Al volver a iniciar sesión, se restaura todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes paquets restent dans ton compte. Tout sera restauré à ta prochaine connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi mazzi restano nel tuo account. Accedendo di nuovo ritrovi tutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus baralhos ficam na sua conta. Entrar de novo restaura tudo."
          }
        }
      }
