    "settings_delete_account_failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte nicht alles gelöscht werden. Du bist noch angemeldet und kannst es nochmal versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not delete everything. You are still signed in, so you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar todo. Sigues con la sesión iniciada, así que puedes intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de tout supprimer. Ta session est toujours active, tu peux donc réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare tutto. Il tuo accesso è ancora attivo, quindi puoi riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを削除できませんでした。サインインしたままなので、もう一度お試しいただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 삭제하지 못했어요. 아직 로그인되어 있으니 다시 시도할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível excluir tudo. Você continua conectado, então pode tentar de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xóa được hết. Bạn vẫn đang đăng nhập nên có thể thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能全部删除。你仍处于登录状态，可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除所有內容。你仍處於登入狀態，可以再試一次。"
          }
        }
      }
    },
