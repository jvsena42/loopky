    "secure_screen_recording_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungsphrase ist verborgen, während der Bildschirm aufgenommen oder gespiegelt wird. Beende die Aufnahme, um sie zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase is hidden while the screen is being recorded or mirrored. Stop the recording to see it."
