    "settings_unsplash_key_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos bei Unsplash: Erstelle im Developer-Dashboard eine Anwendung und kopiere dann ihren Access Key, nicht den Secret Key."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free from Unsplash: create an application in the developer dashboard, then copy its Access Key, not the Secret key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en Unsplash: crea una aplicación en el panel de desarrollador y copia su Access Key, no la Secret key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit sur Unsplash : crée une application dans le tableau de bord développeur, puis copie son Access Key, pas la Secret key."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis da Unsplash: crea un'applicazione nella dashboard per sviluppatori, poi copia la sua Access Key, non la Secret key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash で無料で取得できます。開発者ダッシュボードでアプリケーションを作成し、Secret key ではなく Access Key をコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash에서 무료로 받을 수 있어요. 개발자 대시보드에서 애플리케이션을 만든 뒤 Secret key가 아닌 Access Key를 복사하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis no Unsplash: crie uma aplicação no painel de desenvolvedor e copie a Access Key, não a Secret key."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí từ Unsplash: tạo một ứng dụng trong bảng điều khiển dành cho nhà phát triển, rồi sao chép Access Key của ứng dụng đó, không phải Secret key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从 Unsplash 免费获取：在开发者后台创建一个应用，然后复制它的 Access Key，而不是 Secret key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可從 Unsplash 免費取得：在開發者主控台建立一個應用程式，然後複製它的 Access Key，而不是 Secret key。"
          }
        }
      }
    },
