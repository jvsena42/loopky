    "unregistered_check_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vertipptes oder vertauschtes Wort besteht die Prüfung trotzdem und öffnet ein anderes Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One mistyped or out-of-order word still passes the check and unlocks a different account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra mal escrita o fuera de orden sigue pasando la comprobación y desbloquea otra cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot mal saisi ou dans le désordre passe quand même la vérification et déverrouille un autre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola scritta male o fuori ordine supera comunque il controllo e sblocca un account diverso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語が1つ間違っていたり順番が違っていたりしても確認を通過し、別のアカウントが開かれてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 하나를 잘못 입력하거나 순서가 바뀌어도 검사를 통과해서 다른 계정이 열려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma palavra digitada errada ou fora de ordem ainda passa na verificação e desbloqueia outra conta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần gõ sai hoặc đảo thứ tự một từ, cụm từ vẫn qua được bước kiểm tra nhưng sẽ mở một tài khoản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要有一个单词输错或顺序不对，仍能通过校验，但会解锁另一个账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要有一個單字打錯或順序錯了，仍會通過檢查，並解鎖另一個帳號。"
          }
        }
      }
    },
