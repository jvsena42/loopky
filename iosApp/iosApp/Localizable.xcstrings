    "backup_method_ring_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere deinen Schlüssel in Pubky Ring. Loopky behält seine Kopie auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy your key into Pubky Ring. Loopky keeps its copy too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia tu clave en Pubky Ring. Loopky también conserva su copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie ta clé dans Pubky Ring. Loopky garde aussi sa copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la tua chiave in Pubky Ring. Anche Loopky conserva la sua copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を Pubky Ring にコピーします。Loopky にもコピーが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 Pubky Ring에 복사해요. Loopky에도 사본이 남아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie sua chave para o Pubky Ring. O Loopky mantém a cópia dele também."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép khóa của bạn vào Pubky Ring. Loopky vẫn giữ bản sao của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的密钥复制到 Pubky Ring。Loopky 也会保留一份。"
