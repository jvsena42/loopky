    "settings_unsplash_key_error_invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash hat diesen Schlüssel abgelehnt. Prüfe, ob du den Access Key vollständig kopiert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash rejected that key. Check you copied the Access Key in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash rechazó esa clave. Comprueba que copiaste la Access Key completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash a refusé cette clé. Vérifie que tu as copié l’Access Key en entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash ha rifiutato la chiave. Controlla di aver copiato tutta la Access Key."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash がこのキーを拒否しました。Access Key を全部コピーしたか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash가 이 키를 거부했어요. Access Key를 빠짐없이 복사했는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Unsplash recusou essa chave. Verifique se copiou a Access Key por inteiro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash đã từ chối khóa đó. Hãy kiểm tra xem bạn đã sao chép đầy đủ Access Key chưa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash 拒绝了这个密钥。请确认你完整复制了 Access Key。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash 拒絕了這個金鑰。請確認你完整複製了 Access Key。"
          }
        }
      }
    },
