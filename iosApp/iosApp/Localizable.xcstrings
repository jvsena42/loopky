    "onboarding_still_waiting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte immer noch. Falls Pubky Ring keine Anfrage angezeigt hat, brich ab und versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still waiting. If Pubky Ring didn't show a request, cancel and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos esperando. Si Pubky Ring no mostró ninguna solicitud, cancela e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en attente. Si Pubky Ring n’a affiché aucune demande, annule et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora in attesa. Se Pubky Ring non ha mostrato nessuna richiesta, annulla e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ待っています。Pubky Ring にリクエストが表示されない場合は、キャンセルしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기다리는 중이에요. Pubky Ring에 요청이 보이지 않으면 취소하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda aguardando. Se o pedido não apareceu no Pubky Ring, cancele e tente de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn đang chờ. Nếu Pubky Ring không hiện yêu cầu, hãy hủy và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在等待。如果 Pubky Ring 没有弹出请求，请取消后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在等待。如果 Pubky Ring 沒有顯示請求，請取消後再試一次。"
          }
        }
      }
    },
