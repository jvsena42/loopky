    "profile_name_nudge_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Namen hinzu, damit andere wissen, wem diese Stapel gehören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a name so people know whose decks these are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un nombre para que la gente sepa de quién son estos mazos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un nom pour que les gens sachent à qui sont ces paquets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un nome, così le persone sanno di chi sono questi mazzi."
