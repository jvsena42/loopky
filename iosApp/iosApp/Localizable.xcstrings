    "speak_failed_busy_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Versuch ist noch nicht fertig. Warte einen Moment und versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last attempt hasn’t finished. Give it a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intento anterior aún no ha terminado. Espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière tentative n’est pas terminée. Attends un instant et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tentativo precedente non è ancora finito. Aspetta un attimo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の試行がまだ終わっていません。少し待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 시도가 아직 끝나지 않았어요. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa anterior ainda não terminou. Espere um instante e tente de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần thử trước chưa xong. Đợi một chút rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次尝试还没结束。稍等片刻再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次嘗試還沒結束。稍等一下再試一次。"
          }
        }
      }
    },
