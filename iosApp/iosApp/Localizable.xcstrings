        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à coller. Copie d’abord l’adresse d’une image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da incollare. Prima copia l'indirizzo di un'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けるものがありません。先に画像のアドレスをコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
