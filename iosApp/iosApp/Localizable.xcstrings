    "settings_share_on_pubky_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bietet an, einen Beitrag zu posten, wenn du einen Stapel erstellst, ihm folgst oder ihn kopierst. Deine Stapel sind so oder so öffentlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer to post when you create, follow or copy a deck. Your decks are public either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrecer publicar cuando crees, sigas o copies un mazo. Tus mazos son públicos de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer une annonce quand tu crées, suis ou copies un paquet. Tes paquets sont publics dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponi un post quando crei, segui o copi un mazzo. I tuoi mazzi sono pubblici in ogni caso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferecer publicar quando você criar, seguir ou copiar um baralho. Seus baralhos são públicos de qualquer forma."
          }
        }
      }
    },
    "settings_share_on_pubky_label": {
      "extractionState": "manual",
      "localizations": {
