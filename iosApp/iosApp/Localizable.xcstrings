        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index public de Loopky est tout neuf. Publie un paquet et il apparaîtra ici pour tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice pubblico di Loopky è nuovo. Pubblica un mazzo e comparirà qui per tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky の公開インデックスはできたばかりです。デッキを公開すると、ここに表示されて誰でも見られるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky의 공개 색인은 이제 막 시작됐어요. 덱을 발행하면 모두에게 여기에 보여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O índice público do Loopky é novo. Publique um baralho e ele aparece aqui para todo mundo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mục công khai của Loopky còn mới. Hãy xuất bản một bộ thẻ và mọi người sẽ thấy nó ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 的公开索引刚刚起步。发布一个卡组，所有人都能在这里看到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 的公開索引才剛起步。發布一個牌組，所有人都能在這裡看到它。"
          }
        }
      }
    },
