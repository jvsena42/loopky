    "sign_in_prompt_follow_deck_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du folgst, landet der Stapel in deiner Bibliothek, bleibt aktuell und merkt sich, was du gelernt hast. Dafür brauchst du ein Konto, aber keine E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following saves the deck to your library, keeps it up to date and remembers what you've learned. It needs an account, but no email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seguir un mazo, se guarda en tu biblioteca, se mantiene actualizado y recuerda lo que has aprendido. Necesitas una cuenta, pero no un correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre enregistre le paquet dans ta bibliothèque, le tient à jour et retient ce que tu as appris. Il faut un compte, mais pas d’e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguendo il mazzo lo salvi nella tua libreria, lo tieni aggiornato e ricordi cosa hai imparato. Serve un account, ma nessuna email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir salva o baralho na sua biblioteca, mantém-no atualizado e lembra o que você aprendeu. Precisa de uma conta, mas não de e-mail."
          }
        }
      }
    },
    "sign_in_prompt_follow_deck_title": {
      "extractionState": "manual",
      "localizations": {
