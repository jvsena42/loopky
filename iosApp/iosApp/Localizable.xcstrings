    "deck_detail_delete_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und alles, was du damit gelernt hast, werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and everything you've learned from it will be deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán “%1$@” y todo lo que has aprendido con él. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et tout ce que tu y as appris seront supprimés. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tutto quello che hai imparato con questo mazzo verranno eliminati. Non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tudo o que você aprendeu com ele serão excluídos. Isso não pode ser desfeito."
          }
        }
      }
    },
