    "settings_signout_unbacked_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky hat die einzige Kopie des Schlüssels für %1$@, und du hast ihn nicht gesichert. Beim Abmelden wird er endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky holds the only copy of the key for %1$@, and you haven't backed it up. Signing out deletes it for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky tiene la única copia de la clave de %1$@, y no hiciste una copia de seguridad. Cerrar sesión la borra para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky détient la seule copie de la clé de %1$@, et tu ne l’as pas sauvegardée. Te déconnecter la supprime définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky ha l'unica copia della chiave di %1$@ e non ne hai fatto il backup. Uscendo la elimini per sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky tem a única cópia da chave de %1$@, e você não fez backup. Sair a exclui para sempre."
          }
        }
      }
    },
