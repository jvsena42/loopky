    "bulk_cli_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky hat einen Terminal-Client. Kopiere den Prompt, füge ihn in deinen Coding-Agenten ein und sieh zu, wie ein Stapel in deinem Konto landet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky has a terminal client. Copy the prompt, paste it into your coding agent, and watch a deck land in your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky tiene un cliente de terminal. Copia el prompt, pégalo en tu agente de programación y mira cómo aparece un mazo en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky a un client en ligne de commande. Copie le prompt, colle-le dans ton agent de code et regarde un paquet arriver dans ton compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky ha un client da terminale. Copia il prompt, incollalo nel tuo agente di programmazione e guarda un mazzo arrivare nel tuo account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky tem um cliente de terminal. Copie o prompt, cole no seu agente de código e veja um baralho aparecer na sua conta."
          }
        }
      }
    },
