        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mazo no terminó de subirse, así que faltan algunas tarjetas. Vuelve a importarlo para completarlo, o elimínalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de ce paquet ne s’est pas terminé, il manque donc des cartes. Importe-le à nouveau pour le compléter, ou supprime-le."
