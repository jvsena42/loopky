      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine E-Mail nötig. Bestätige per SMS oder mit einer kleinen Zahlung, oder nutze einen Einladungscode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No email needed. Verify with a text or a small payment, or use an invite code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta correo. Verifícate con un SMS o un pequeño pago, o usa un código de invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas besoin d’e-mail. Vérifie par SMS ou avec un petit paiement, ou utilise un code d’invitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente email. Verifica con un SMS o un piccolo pagamento, oppure usa un codice invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールは不要です。SMS か少額の支払いで確認するか、招待コードを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일은 필요 없어요. 문자나 소액 결제로 인증하거나, 초대 코드를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem e-mail. Confirme por SMS ou com um pequeno pagamento, ou use um código de convite."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần email. Xác minh bằng tin nhắn hoặc một khoản thanh toán nhỏ, hoặc dùng mã mời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需邮箱。通过短信或一笔小额付款验证，或者使用邀请码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需要電子郵件。用簡訊或一筆小額付款驗證，或使用邀請碼。"
          }
        }
      }
    },
    "signup_start_title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweise, dass du kein Roboter bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prove you're not a robot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demuestra que no eres un robot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prouve que tu n’es pas un robot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimostra di non essere un robot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロボットではないことを証明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로봇이 아님을 증명해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prove que você não é um robô."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chứng minh bạn không phải robot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证明你不是机器人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明你不是機器人。"
          }
        }
      }
    },
