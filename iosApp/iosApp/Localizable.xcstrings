        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしたデッキを削除できませんでした。一部がまだ保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소한 덱을 삭제하지 못했어요. 일부가 아직 저장되어 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover o baralho cancelado. Parte dele continua salva."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xóa được bộ thẻ đã hủy. Một phần vẫn còn được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除已取消的卡组，部分内容仍然保存着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法移除已取消的牌組，部分內容仍已儲存。"
          }
        }
      }
    },
