    "settings_interval_mastery_note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab deinem längsten Intervall gilt eine Karte als gemeistert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your longest interval is when a card counts as mastered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una tarjeta llega a tu intervalo más largo, cuenta como dominada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte compte comme maîtrisée quand elle atteint ton intervalle le plus long."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una carta raggiunge il tuo intervallo più lungo, conta come imparata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も長い間隔に達したカードが「習得済み」になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 긴 간격에 도달하면 카드를 숙달한 것으로 쳐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu maior intervalo é quando uma carta conta como dominada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thẻ đạt khoảng cách dài nhất của bạn, thẻ được tính là đã thành thạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到你设置的最长间隔时，卡片即算作已掌握。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片到達你最長的間隔時，就算是已熟記。"
          }
        }
      }
    },
    "settings_language_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS speichert die Sprache von Loopky zusammen mit deinen anderen App-Spracheinstellungen. Tippe, um sie dort zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS keeps Loopky's language with your other per-app language settings. Tap to change it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS guarda el idioma de Loopky junto con tus otras preferencias de idioma por app. Toca para cambiarlo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS conserve la langue de Loopky avec tes autres réglages de langue par app. Touche pour la changer là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS conserva la lingua di Loopky insieme alle altre impostazioni della lingua per app. Tocca per cambiarla lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がほかのアプリ別の言語設定と一緒に Loopky の言語を管理します。タップしてそこで変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 다른 앱별 언어 설정과 함께 Loopky의 언어를 보관해요. 탭해서 그곳에서 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS guarda o idioma do Loopky junto com suas outras configurações de idioma por app. Toque para alterar lá."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS lưu ngôn ngữ của Loopky cùng các cài đặt ngôn ngữ riêng cho từng ứng dụng khác. Nhấn để đổi ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会将 Loopky 的语言与其他应用的语言设置一起保存。点按即可前往更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會將 Loopky 的語言與你其他 App 的語言設定一起保存。點一下即可前往變更。"
          }
        }
      }
    },
