        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズで保護したファイルを「ファイル」か iCloud Drive に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보호된 파일을 파일 앱이나 iCloud Drive에 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um arquivo protegido por senha nos Arquivos ou no iCloud Drive."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tệp được bảo vệ bằng cụm mật khẩu vào Tệp hoặc iCloud Drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将受密码短语保护的文件保存到“文件”或 iCloud 云盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將受密碼短語保護的檔案儲存到「檔案」或 iCloud 雲碟。"
          }
        }
      }
    },
