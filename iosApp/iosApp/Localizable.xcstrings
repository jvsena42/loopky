    "backup_nag_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel existiert nur auf diesem Gerät. Verlierst du ihn, sind auch deine Stapel weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key lives only on this device. If you lose it, your decks go with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave solo existe en este dispositivo. Si la pierdes, tus mazos se van con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta clé n’existe que sur cet appareil. Si tu la perds, tes paquets disparaissent avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave esiste solo su questo dispositivo. Se la perdi, perdi anche i tuoi mazzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave existe só neste aparelho. Se você perdê-la, seus baralhos vão junto."
          }
        }
      }
    },
