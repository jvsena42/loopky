    "settings_theme_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Loopky auf diesem Gerät. Auto wird von %1$@ bis %2$@ dunkel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to Loopky on this device only. Auto turns dark from %1$@ to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a Loopky en este dispositivo. El modo Automático usa el tema oscuro de %1$@ a %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique uniquement à Loopky sur cet appareil. Auto passe en sombre de %1$@ à %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale solo per Loopky su questo dispositivo. Automatico passa allo scuro dalle %1$@ alle %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの Loopky にのみ適用されます。「自動」では %1$@ から %2$@ までダークになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 Loopky에만 적용돼요. 자동은 %1$@부터 %2$@까지 어둡게 바뀌어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale só para o Loopky neste aparelho. O automático escurece das %1$@ às %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ áp dụng cho Loopky trên thiết bị này. Tự động chuyển sang tối từ %1$@ đến %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对本设备上的 Loopky 生效。“自动”会在 %1$@ 至 %2$@ 使用深色模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於此裝置上的 Loopky。「自動」會在 %1$@ 到 %2$@ 之間切換為深色。"
          }
        }
      }
    },
