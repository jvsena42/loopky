    "backup_ring_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel wird in Pubky Ring kopiert. Loopky behält seine eigene Kopie, und deine Wiederherstellungsphrase funktioniert weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copies your key into Pubky Ring. Loopky keeps its own copy, and your recovery phrase still works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto copia tu clave en Pubky Ring. Loopky conserva su propia copia, y tu frase de recuperación sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci copie ta clé dans Pubky Ring. Loopky garde sa propre copie, et ta phrase de récupération fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo copia la tua chiave in Pubky Ring. Loopky conserva la sua copia e la tua frase di recupero continua a funzionare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso copia sua chave para o Pubky Ring. O Loopky mantém a própria cópia, e sua frase de recuperação continua valendo."
          }
        }
      }
    },
