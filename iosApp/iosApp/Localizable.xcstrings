    "secure_screen_recording_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungsphrase ist verborgen, während der Bildschirm aufgenommen oder gespiegelt wird. Beende die Aufnahme, um sie zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase is hidden while the screen is being recorded or mirrored. Stop the recording to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de recuperación se oculta mientras la pantalla se graba o se duplica. Detén la grabación para verla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta phrase de récupération est masquée pendant l’enregistrement ou la recopie de l’écran. Arrête l’enregistrement pour la voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua frase di recupero è nascosta mentre lo schermo viene registrato o duplicato. Interrompi la registrazione per vederla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の収録中またはミラーリング中は、リカバリーフレーズが隠されます。表示するには収録を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 녹화되거나 미러링되는 동안에는 복구 문구가 숨겨져요. 보려면 녹화를 멈추세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase de recuperação fica oculta enquanto a tela está sendo gravada ou espelhada. Pare a gravação para vê-la."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm từ khôi phục của bạn bị ẩn khi màn hình đang được ghi hoặc phản chiếu. Hãy dừng ghi để xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕正在录制或镜像时，你的恢复短语会被隐藏。停止录制即可查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕正在錄影或鏡像輸出時，你的復原短語會被隱藏。停止錄影即可查看。"
          }
        }
      }
    },
