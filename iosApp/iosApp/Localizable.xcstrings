    "settings_delete_account_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stapel, Karten, Bilder und dein Lernfortschritt werden endgültig gelöscht, und dein Profil wird aus Loopky entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your decks, cards, images and study progress will be permanently deleted, and your profile will be removed from Loopky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mazos, tarjetas, imágenes y progreso de estudio se eliminarán para siempre, y tu perfil se quitará de Loopky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes paquets, cartes, images et ta progression seront définitivement supprimés, et ton profil sera retiré de Loopky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi mazzi, le carte, le immagini e i progressi di studio verranno eliminati definitivamente, e il tuo profilo verrà rimosso da Loopky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキ、カード、画像、学習の進捗は完全に削除され、プロフィールは Loopky から削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덱, 카드, 이미지, 학습 진행 상황이 영구적으로 삭제되고, 프로필이 Loopky에서 제거돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus baralhos, cartas, imagens e progresso de estudo serão excluídos permanentemente, e seu perfil será removido do Loopky."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ, thẻ, hình ảnh và tiến độ học của bạn sẽ bị xóa vĩnh viễn, và hồ sơ của bạn sẽ bị gỡ khỏi Loopky."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的卡组、卡片、图片和学习进度将被永久删除，你的个人主页也将从 Loopky 中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的牌組、卡片、圖片和學習進度都會被永久刪除，你的個人檔案也會從 Loopky 移除。"
          }
        }
      }
    },
