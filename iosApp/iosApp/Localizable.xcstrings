        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave con la que iniciaste sesión es una cuenta de Pubky. Mira tu perfil y tus publicaciones en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé utilisée pour ta connexion est un compte Pubky. Retrouve ton profil et tes publications sur le web."
          }
