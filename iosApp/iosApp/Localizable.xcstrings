        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を追加すると、誰のデッキなのかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 추가하면 누구의 덱인지 다른 사람들이 알 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um nome para as pessoas saberem de quem são estes baralhos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tên để mọi người biết các bộ thẻ này là của ai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加个名字，大家就知道这些卡组是谁的了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加上名稱，讓大家知道這些是誰的牌組。"
          }
        }
      }
    },
