    "restore_seed_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib hier niemals die Wiederherstellungsphrase einer Bitcoin- oder anderen Krypto-Wallet ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never enter a Bitcoin or other crypto wallet recovery phrase here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca escribas aquí la frase de recuperación de una billetera de Bitcoin u otra cripto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisis jamais ici la phrase de récupération d’un portefeuille Bitcoin ou d’une autre crypto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non inserire mai qui la frase di recupero di un wallet Bitcoin o di altre criptovalute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットコインなどの暗号資産ウォレットのリカバリーフレーズは、絶対にここに入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트코인이나 다른 암호화폐 지갑의 복구 문구는 절대 여기에 입력하지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca digite aqui a frase de recuperação de uma carteira de Bitcoin ou de outra cripto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt đối không nhập cụm từ khôi phục của ví Bitcoin hay ví tiền mã hóa khác vào đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切勿在这里输入比特币或其他加密货币钱包的恢复短语（助记词）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕對不要在這裡輸入比特幣或其他加密貨幣錢包的復原短語。"
          }
        }
      }
    },
