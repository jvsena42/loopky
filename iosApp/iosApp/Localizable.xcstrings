    "backup_phrase_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib diese zwölf Wörter in der richtigen Reihenfolge auf und bewahre sie sicher auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write these twelve words down, in order, and keep them somewhere safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota estas doce palabras, en orden, y guárdalas en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note ces douze mots, dans l’ordre, et garde-les en lieu sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi queste dodici parole, in ordine, e conservale in un posto sicuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote estas doze palavras, na ordem, e guarde em lugar seguro."
          }
        }
      }
    },
