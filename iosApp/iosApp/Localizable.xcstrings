    "restore_error_no_account_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Phrase ist gültig, aber es wurde noch kein Konto dafür erstellt. Achte auf ein vertipptes oder vertauschtes Wort. Die Phrase einer Bitcoin- oder Krypto-Wallet funktioniert hier nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phrase is valid, but no account has been created for it. Check for a mistyped or out-of-order word. A Bitcoin or crypto wallet phrase won't work here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase es válida, pero no se ha creado ninguna cuenta para ella. Busca una palabra mal escrita o fuera de orden. La frase de una billetera de Bitcoin o cripto no funciona aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette phrase est valide, mais aucun compte n’a été créé pour elle. Cherche un mot mal saisi ou dans le désordre. Une phrase de portefeuille Bitcoin ou crypto ne fonctionnera pas ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa frase è valida, ma non è stato creato nessun account per questa frase. Cerca una parola scritta male o fuori ordine. La frase di un wallet Bitcoin o di criptovalute qui non funziona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase é válida, mas nenhuma conta foi criada para ela. Procure uma palavra digitada errada ou fora de ordem. A frase de uma carteira de Bitcoin ou cripto não funciona aqui."
          }
        }
      }
    },
