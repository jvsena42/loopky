    "bulk_error_not_text_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Anki-.apkg oder einen als reinen Text exportierten Stapel. Aus Fotos und PDFs werden keine Karten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an Anki .apkg, or a deck exported as plain text. Photos and PDFs can't become cards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un .apkg de Anki, o un mazo exportado como texto plano. Las fotos y los PDF no se pueden convertir en tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un .apkg Anki, ou un paquet exporté en texte brut. Les photos et les PDF ne peuvent pas devenir des cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un .apkg di Anki, oppure un mazzo esportato come testo semplice. Foto e PDF non possono diventare carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki の .apkg か、プレーンテキストでエクスポートしたデッキを選んでください。写真や PDF はカードにできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki .apkg 파일이나 일반 텍스트로 내보낸 덱을 고르세요. 사진과 PDF는 카드로 만들 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um .apkg do Anki, ou um baralho exportado como texto puro. Fotos e PDFs não viram cartas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một tệp .apkg của Anki, hoặc bộ thẻ xuất ra dạng văn bản thuần. Ảnh và PDF không thể trở thành thẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 Anki 的 .apkg 文件，或导出为纯文本的卡组。照片和 PDF 无法变成卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 Anki .apkg，或以純文字匯出的牌組。照片和 PDF 無法變成卡片。"
          }
        }
      }
    },
