    "unregistered_register_hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein Konto für den Schlüssel oben und veröffentlicht es. Erfordert eine kurze Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an account for the key above and publishes it. Needs a quick verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta para la clave de arriba y la publica. Requiere una verificación rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un compte pour la clé ci-dessus et la publie. Nécessite une vérification rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un account per la chiave qui sopra e lo pubblica. Serve una verifica veloce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria uma conta para a chave acima e a publica. Precisa de uma verificação rápida."
          }
        }
      }
    },
    "unregistered_ring_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring verwahrt diesen Schlüssel, deshalb kann Loopky kein Konto dafür erstellen. Zwei Wege, ihn zu behalten: Hol dir hier einen Einladungscode und nutze in Ring „Pubky bearbeiten“, oder lass dir in Ring die Wiederherstellungsphrase anzeigen und stelle ihn hier wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring holds this key, so Loopky can't create its account. Two ways to keep it: get an invite code here and use Ring's Edit pubky sheet, or reveal the recovery phrase in Ring and restore it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring guarda esta clave, así que Loopky no puede crear su cuenta. Hay dos formas de conservarla: consigue aquí un código de invitación y usa la pantalla Editar pubky de Ring, o muestra la frase de recuperación en Ring y restáurala aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring détient cette clé, donc Loopky ne peut pas créer son compte. Deux façons de la garder : obtenir un code d’invitation ici et utiliser l’écran Modifier le pubky de Ring, ou afficher la phrase de récupération dans Ring et la restaurer ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring custodisce questa chiave, quindi Loopky non può crearne l'account. Hai due modi per tenerla: ottieni qui un codice invito e usa la schermata Modifica pubky di Ring, oppure mostra la frase di recupero in Ring e ripristinala qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pubky Ring guarda esta chave, então o Loopky não consegue criar a conta dela. Dois caminhos: obter um código de convite aqui e usar a tela Editar pubky do Ring, ou revelar a frase de recuperação no Ring e restaurá-la aqui."
          }
        }
      }
    },
