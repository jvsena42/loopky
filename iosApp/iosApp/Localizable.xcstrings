    "deck_incomplete_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Stapel wurde nicht vollständig hochgeladen, daher fehlen einige Karten. Importiere ihn erneut, um ihn zu vervollständigen, oder lösche ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deck didn't finish uploading, so some cards are missing. Import it again to complete it, or delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mazo no terminó de subirse, así que faltan algunas tarjetas. Vuelve a importarlo para completarlo, o elimínalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi de ce paquet ne s’est pas terminé, il manque donc des cartes. Importe-le à nouveau pour le compléter, ou supprime-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caricamento di questo mazzo non è terminato, quindi mancano alcune carte. Importalo di nuovo per completarlo, oppure eliminalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデッキはアップロードが完了しなかったため、一部のカードが欠けています。もう一度インポートして完成させるか、削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 덱은 업로드가 끝나지 않아 일부 카드가 빠져 있어요. 다시 가져와서 완성하거나 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este baralho não terminou de enviar, então faltam algumas cartas. Importe-o de novo para completá-lo, ou exclua-o."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ này chưa tải lên xong nên còn thiếu một số thẻ. Hãy nhập lại để hoàn tất, hoặc xóa nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个卡组没有上传完成，部分卡片缺失。请重新导入以补全，或将其删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個牌組沒有上傳完成，所以缺少部分卡片。請再次匯入以完成，或將它刪除。"
          }
        }
      }
    },
