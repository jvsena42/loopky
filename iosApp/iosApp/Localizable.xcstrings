    "bulk_error_unsupported_apkg_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuere Anki-Stapel nutzen ein Format, das Loopky noch nicht liest. Exportiere den Stapel in Anki stattdessen als „Notizen als reiner Text“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newer Anki decks use a format Loopky doesn't read yet. In Anki, export the deck as “Notes in Plain Text” instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mazos más nuevos de Anki usan un formato que Loopky todavía no lee. En Anki, exporta el mazo como “Notas en texto plano”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets Anki récents utilisent un format que Loopky ne lit pas encore. Dans Anki, exporte plutôt le paquet en « Notes en texte brut »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mazzi Anki più recenti usano un formato che Loopky non legge ancora. In Anki, esporta invece il mazzo come “Note in testo semplice”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baralhos mais novos do Anki usam um formato que o Loopky ainda não lê. No Anki, exporte o baralho como “Notas em texto puro”."
          }
        }
      }
    },
