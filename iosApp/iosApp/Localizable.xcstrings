    "tag_browse_empty_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand auf Loopky hat dieses Tag verwendet. Veröffentliche einen Stapel damit, und er erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody on Loopky has used this tag yet. Publish a deck with it and it shows up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie en Loopky ha usado esta etiqueta todavía. Publica un mazo con ella y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne sur Loopky n’a encore utilisé ce tag. Publie un paquet avec et il apparaîtra ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno su Loopky ha ancora usato questo tag. Pubblica un mazzo con questo tag e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky でこのタグを使った人はまだいません。このタグを付けてデッキを公開すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky에서 아직 아무도 이 태그를 쓰지 않았어요. 이 태그로 덱을 발행하면 여기에 보여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém no Loopky usou esta tag ainda. Publique um baralho com ela e ele aparece aqui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ai trên Loopky dùng nhãn này. Hãy xuất bản một bộ thẻ với nhãn này và nó sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 上还没有人用过这个标签。发布一个带这个标签的卡组，它就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 上還沒有人使用這個標籤。用它發布一個牌組，就會出現在這裡。"
          }
        }
      }
    },
