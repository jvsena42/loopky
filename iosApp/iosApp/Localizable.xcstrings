    "settings_new_cards_goal_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ziel, keine Grenze. Du kannst immer weitermachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A goal, not a limit. You can always keep going."
          }
