    "permission_camera_denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky braucht die Kamera, um einen QR-Code zu lesen. Du kannst sie in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky needs the camera to read a QR code. You can turn it on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky necesita la cámara para leer un código QR. Puedes activarla en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky a besoin de l’appareil photo pour lire un code QR. Tu peux l’activer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky ha bisogno della fotocamera per leggere un codice QR. Puoi attivarla nelle Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky precisa da câmera para ler um código QR. Você pode ligar nos Ajustes."
          }
        }
      }
    },
    "permission_mic_denied_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen braucht Zugriff auf das Mikrofon, und Android fragt nicht noch einmal. Du kannst ihn in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak needs microphone access, and Android won't ask again. You can turn it on in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Hablar necesita acceso al micrófono, y Android no volverá a preguntar. Puedes activarlo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler a besoin d’accéder au micro, et Android ne te le redemandera pas. Tu peux l’activer dans les Paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla ha bisogno dell'accesso al microfono e Android non lo chiederà di nuovo. Puoi attivarlo nelle Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Falar precisa de acesso ao microfone, e o Android não vai perguntar de novo. Você pode ligar nas Configurações."
          }
        }
      }
    },
    "permission_mic_denied_title": {
      "extractionState": "manual",
