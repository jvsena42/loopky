    "pubky_app_cta_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel, mit dem du dich angemeldet hast, ist ein Pubky-Konto. Sieh dir dein Profil und deine Beiträge im Web an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key you signed in with is a Pubky account. See your profile and posts on the web."
          }
