    "speak_failed_network_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung braucht gerade eine Verbindung. Prüfe deine und versuch es nochmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition needs a connection right now. Check yours and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz necesita conexión en este momento. Revisa la tuya e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale a besoin d’une connexion pour le moment. Vérifie la tienne et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale ora ha bisogno di una connessione. Controlla la tua e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、音声認識には接続が必要です。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 음성 인식에 인터넷 연결이 필요해요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala precisa de conexão agora. Confira a sua e tente de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc này nhận dạng giọng nói cần có kết nối mạng. Hãy kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别目前需要联网。请检查网络连接后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識目前需要網路連線。請檢查連線後再試一次。"
          }
        }
      }
    },
