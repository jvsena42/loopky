    "backup_method_phrase_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib zwölf Wörter auf und bestätige sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down twelve words and confirm them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota doce palabras y confírmalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note douze mots et confirme-les."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi dodici parole e confermale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12個の単語を書き留めて確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12개의 단어를 적고 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote doze palavras e confirme-as."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại mười hai từ và xác nhận chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抄下十二个单词并确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抄寫下十二個單字並確認。"
          }
        }
      }
    },
