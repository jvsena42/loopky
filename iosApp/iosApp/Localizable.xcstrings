    "onboarding_hero_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilte Wiederholung, die sich wie ein Spiel anfühlt. Stapel, die du erstellst, teilst und von Freunden lernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaced repetition that feels like a game. Decks you make, share, and learn from friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetición espaciada que se siente como un juego. Mazos que creas, compartes y aprendes con amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La répétition espacée qui ressemble à un jeu. Des paquets à créer, à partager et à apprendre entre amis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripetizione dilazionata che sembra un gioco. Mazzi da creare, condividere e imparare dagli amici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetição espaçada com cara de jogo. Baralhos que você cria, compartilha e aprende com amigos."
          }
        }
      }
    },
