    "bulk_error_too_large_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky kann Dateien bis %1$lld MB importieren. Das ist größer als jeder Stapel auf AnkiWeb, also ist das wahrscheinlich kein Anki-Export."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky can import files up to %1$lld MB. That's larger than any deck on AnkiWeb, so this is likely not an Anki export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky puede importar archivos de hasta %1$lld MB. Eso es más que cualquier mazo de AnkiWeb, así que probablemente no sea una exportación de Anki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky peut importer des fichiers jusqu’à %1$lld Mo. C’est plus que n’importe quel paquet sur AnkiWeb, donc ce n’est probablement pas un export Anki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky può importare file fino a %1$lld MB. È più grande di qualsiasi mazzo su AnkiWeb, quindi probabilmente non è un'esportazione di Anki."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky がインポートできるのは %1$lld MB までのファイルです。これは AnkiWeb のどのデッキよりも大きいので、Anki のエクスポートではない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky는 최대 %1$lld MB 파일까지 가져올 수 있어요. AnkiWeb의 어떤 덱보다도 크니 Anki 내보내기 파일이 아닐 가능성이 커요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky importa arquivos de até %1$lld MB. Isso é maior que qualquer baralho no AnkiWeb, então provavelmente não é uma exportação do Anki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky có thể nhập tệp tối đa %1$lld MB. Tệp này lớn hơn mọi bộ thẻ trên AnkiWeb, nên có lẽ đây không phải tệp xuất từ Anki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 可导入的文件最大为 %1$lld MB。这比 AnkiWeb 上的任何卡组都大，所以它很可能不是 Anki 导出文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 可以匯入最大 %1$lld MB 的檔案。這比 AnkiWeb 上任何牌組都大，所以這很可能不是 Anki 匯出檔。"
          }
        }
      }
    },
