    "settings_delete_account_dialog_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stapel, Karten, Bilder und dein Lernfortschritt werden endgültig gelöscht, und dein Profil wird aus Loopky entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your decks, cards, images and study progress will be permanently deleted, and your profile will be removed from Loopky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mazos, tarjetas, imágenes y progreso de estudio se eliminarán para siempre, y tu perfil se quitará de Loopky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes paquets, cartes, images et ta progression seront définitivement supprimés, et ton profil sera retiré de Loopky."
          }
        },
