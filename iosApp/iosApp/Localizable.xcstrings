    "profile_sign_out_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stapel bleiben in deinem Konto. Wenn du dich wieder anmeldest, ist alles wieder da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your decks stay in your account. Signing back in restores everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mazos se quedan en tu cuenta. Al volver a iniciar sesión, se restaura todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes paquets restent dans ton compte. Tout sera restauré à ta prochaine connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi mazzi restano nel tuo account. Accedendo di nuovo ritrovi tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキはアカウントに残ります。もう一度サインインすれば、すべて元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덱은 계정에 그대로 남아요. 다시 로그인하면 모두 복원돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus baralhos ficam na sua conta. Entrar de novo restaura tudo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ thẻ của bạn vẫn ở trong tài khoản. Đăng nhập lại sẽ khôi phục mọi thứ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的卡组会保留在账号中。重新登录即可恢复一切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的牌組會留在你的帳號中。重新登入即可恢復一切。"
          }
        }
      }
    },
