    "study_preview_guest_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Konto, dann merkt sich dieser Stapel, was du richtig hattest, und fragt nochmal, kurz bevor du es vergessen würdest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account and this deck remembers what you got right, and asks again just before you'd forget it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta y este mazo recordará lo que acertaste, y te volverá a preguntar justo antes de que lo olvides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un compte et ce paquet retiendra ce que tu as réussi, et te le redemandera juste avant que tu l’oublies."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un account e questo mazzo ricorderà cosa hai indovinato, e te lo richiederà poco prima che tu lo dimentichi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma conta e este baralho lembra o que você acertou, e pergunta de novo pouco antes de você esquecer."
          }
        }
      }
    },
