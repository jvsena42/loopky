    "bulk_error_no_cards_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky hat die Datei gelesen, aber nichts gefunden, das nach Karten aussieht. Jede Zeile braucht eine Vorder- und eine Rückseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky read the file but found nothing card-shaped. Each line needs a front and a back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky leyó el archivo pero no encontró nada con forma de tarjeta. Cada línea necesita un anverso y un reverso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky a lu le fichier mais n’y a rien trouvé qui ressemble à une carte. Chaque ligne doit avoir un recto et un verso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky ha letto il file ma non ha trovato niente che somigli a una carta. Ogni riga ha bisogno di un fronte e di un retro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky leu o arquivo mas não achou nada com formato de carta. Cada linha precisa de uma frente e um verso."
          }
        }
      }
    },
