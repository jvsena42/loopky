    "bulk_format_text_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: Datei → Exportieren → „Notizen als reiner Text“. Jede durch Tabulatoren oder Kommas getrennte Liste funktioniert auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: File → Export → “Notes in Plain Text”. Any tab- or comma-separated list works too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Anki: Archivo → Exportar → “Notas en texto plano”. También sirve cualquier lista separada por tabulaciones o comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Anki : Fichier → Exporter → « Notes en texte brut ». Toute liste séparée par des tabulations ou des virgules fonctionne aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: File → Esporta → “Note in testo semplice”. Va bene anche qualsiasi lista separata da tabulazioni o virgole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki で「ファイル」→「エクスポート」→「プレーンテキストのノート」を選びます。タブ区切りやカンマ区切りのリストでもインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki에서: 파일 → 내보내기 → “일반 텍스트로 된 노트”. 탭이나 쉼표로 구분된 목록도 모두 돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Anki: Arquivo → Exportar → “Notas em texto puro”. Qualquer lista separada por tabulação ou vírgula também funciona."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Anki: File → Export → “Notes in Plain Text”. Mọi danh sách phân tách bằng tab hoặc dấu phẩy cũng đều dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Anki 中：文件 → 导出 → “纯文本格式的笔记”。任何以制表符或逗号分隔的列表也可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Anki 中：檔案 → 匯出 → 「純文字筆記」（Notes in Plain Text）。任何以 Tab 或逗號分隔的清單也可以。"
          }
        }
      }
    },
