    "signup_ring_recommended_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring bewahrt deinen Schlüssel in einer separaten App auf, sodass er beim Anmelden nie offengelegt wird. Installiere die App oder erstelle deinen Schlüssel stattdessen in Loopky."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring keeps your key in a separate app, so signing in never exposes it. Install it, or create your key in Loopky instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring guarda tu clave en una app aparte, así que iniciar sesión nunca la expone. Instálalo, o crea tu clave en Loopky."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring garde ta clé dans une app séparée, donc la connexion ne l’expose jamais. Installe-le, ou crée plutôt ta clé dans Loopky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubky Ring tiene la tua chiave in un'app separata, così accedere non la espone mai. Installalo, oppure crea la tua chiave direttamente in Loopky."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pubky Ring guarda sua chave em um app separado, então entrar nunca a expõe. Instale-o, ou crie sua chave no Loopky mesmo."
          }
        }
      }
    },
