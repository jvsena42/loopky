    "deck_editor_error_cards": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karten dieses Stapels konnten nicht geladen werden. Änderungen an den Details des Stapels werden trotzdem gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load this deck's cards. Changes to the deck's details will still save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las tarjetas de este mazo. Los cambios en los detalles del mazo se guardarán igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les cartes de ce paquet. Les modifications des détails du paquet seront quand même enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le carte di questo mazzo. Le modifiche ai dettagli del mazzo verranno comunque salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデッキのカードを読み込めませんでした。デッキの詳細の変更は保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 덱의 카드를 불러오지 못했어요. 덱 정보 변경 사항은 그대로 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as cartas deste baralho. As alterações nos detalhes ainda serão salvas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được các thẻ của bộ thẻ này. Thay đổi thông tin bộ thẻ vẫn sẽ được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载这个卡组的卡片。对卡组信息的修改仍会保存。"
          }
        },
        "zh-Hant": {
