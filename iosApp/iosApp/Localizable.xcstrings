    "settings_study_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Lerneinstellungen konnten nicht geladen werden. Bearbeiten ist aus, bis sie da sind, damit nichts überschrieben wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your study settings. Editing is off until they arrive, so nothing is overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar tu configuración de estudio. La edición está desactivada hasta que llegue, para no sobrescribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger tes paramètres d’étude. La modification reste désactivée jusqu’à leur arrivée, pour que rien ne soit écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le impostazioni di studio. La modifica resta disattivata finché non arrivano, così non viene sovrascritto nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar suas configurações de estudo. A edição fica desligada até que cheguem, para que nada seja sobrescrito."
          }
        }
      }
    },
