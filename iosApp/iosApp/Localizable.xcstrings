    "backup_strength_fair": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel. 16 Zeichen oder mehr sind viel stärker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair. 16 characters or more is much stronger"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptable. Con 16 caracteres o más es mucho más segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyen. 16 caractères ou plus, c’est bien plus solide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Discreta. Con 16 caratteri o più è molto più forte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通。16文字以上にするとずっと強くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통. 16자 이상이면 훨씬 강해져요"
          }
        },
        "pt-BR": {
