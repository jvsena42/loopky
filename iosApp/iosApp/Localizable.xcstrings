    "bulk_format_apkg_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Karten, der Name des Stapels und seine Bilder kommen mit. Audio nicht, diese Karten werden also als Text importiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cards, the deck's name and its pictures come across. Audio doesn't, so those cards import as text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se importan tus tarjetas, el nombre del mazo y sus imágenes. El audio no, así que esas tarjetas llegan como texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cartes, le nom du paquet et ses images sont repris. L’audio non, donc ces cartes sont importées en texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivano le tue carte, il nome del mazzo e le sue immagini. L'audio no, quindi quelle carte vengono importate come testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas cartas, o nome do baralho e as imagens vêm junto. O áudio não vem, então essas cartas chegam como texto."
          }
        }
      }
    },
