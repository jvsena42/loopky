        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この12個の単語を順番どおりに書き留めて、安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 12개의 단어를 순서대로 적어서 안전한 곳에 보관하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote estas doze palavras, na ordem, e guarde em lugar seguro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi lại mười hai từ này theo đúng thứ tự và cất ở nơi an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
