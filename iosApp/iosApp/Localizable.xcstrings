    "unregistered_register_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird %1$@ als öffentliche Identität veröffentlicht. Tu das niemals mit der Wiederherstellungsphrase einer Bitcoin- oder Krypto-Wallet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This publishes %1$@ as a public identity. Never do this with a Bitcoin or crypto wallet recovery phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto publica %1$@ como identidad pública. Nunca lo hagas con la frase de recuperación de una billetera de Bitcoin o cripto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci publie %1$@ comme identité publique. Ne fais jamais ça avec la phrase de récupération d’un portefeuille Bitcoin ou crypto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo pubblica %1$@ come identità pubblica. Non farlo mai con la frase di recupero di un wallet Bitcoin o di criptovalute."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso publica %1$@ como identidade pública. Nunca faça isso com a frase de recuperação de uma carteira de Bitcoin ou cripto."
          }
        }
      }
    },
