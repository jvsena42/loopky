    "sign_in_prompt_follow_person_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Leuten folgst, erscheinen ihre veröffentlichten Stapel unter Entdecken. Dafür brauchst du ein Konto, aber keine E-Mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following puts the decks people publish on your Discover. It needs an account, but no email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al seguir a alguien, los mazos que publica aparecen en tu Descubrir. Necesitas una cuenta, pero no un correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre des gens affiche les paquets qu’ils publient dans ton Découvrir. Il faut un compte, mais pas d’e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguendo le persone, i mazzi che pubblicano compaiono nel tuo Scopri. Serve un account, ma nessuna email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir coloca os baralhos que as pessoas publicam no seu Descobrir. Precisa de uma conta, mas não de e-mail."
          }
        }
      }
    },
