    "publish_error_cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der abgebrochene Stapel konnte nicht entfernt werden. Ein Teil davon ist noch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't remove the cancelled deck. Part of it is still saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo quitar el mazo cancelado. Una parte sigue guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer le paquet annulé. Une partie reste enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere il mazzo annullato. Una parte è ancora salvata."
