    "permission_mic_rationale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen hört zu, während du das Wort sagst, und zeigt dir, wie nah du dran warst. Die Aufnahme verlässt nie dein Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak listens while you say the word and tells you how close you were. Audio never leaves your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Hablar te escucha mientras dices la palabra y te dice cuánto te acercaste. El audio nunca sale de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parler écoute pendant que tu dis le mot et t’indique si tu étais proche. L’audio ne quitte jamais ton appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla ti ascolta mentre pronunci la parola e ti dice quanto era precisa la tua pronuncia. L'audio non lascia mai il tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Falar escuta enquanto você diz a palavra e conta o quanto você chegou perto. O áudio nunca sai do seu aparelho."
          }
        }
      }
    },
    "permission_mic_title": {
