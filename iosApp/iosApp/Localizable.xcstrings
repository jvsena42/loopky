            "value": "Beim Lesen der Datei ist etwas schiefgelaufen. Versuch eine andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong reading that file. Try another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al leer ese archivo. Prueba con otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu pendant la lecture de ce fichier. Essaies-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto nella lettura del file. Provane un altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao ler esse arquivo. Tente outro."
          }
        }
      }
    },
