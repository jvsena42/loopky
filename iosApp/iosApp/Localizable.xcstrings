            "value": "Das Stundenlimit von Unsplash ist aufgebraucht. Mit deinem eigenen Schlüssel bekommst du dein eigenes Limit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash's hourly limit is used up. Your own key gets you your own limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el límite por hora de Unsplash. Con tu propia clave tienes tu propio límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite horaire d’Unsplash est atteinte. Avec ta propre clé, tu as ta propre limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite orario di Unsplash è esaurito. Con una chiave tua hai un limite tutto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash の1時間あたりの上限に達しました。自分のキーを使えば、自分専用の上限になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash의 시간당 한도를 다 썼어요. 내 키를 쓰면 한도도 따로 받아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite por hora do Unsplash acabou. Com sua própria chave você tem seu próprio limite."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hết giới hạn theo giờ của Unsplash. Khóa riêng sẽ cho bạn giới hạn riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash 的每小时额度已用完。使用你自己的密钥即可获得单独的额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsplash 每小時的額度已用完。使用你自己的金鑰，就有你自己的額度。"
          }
        }
      }
    },
