    "deck_incomplete_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Stapel wurde nicht vollständig hochgeladen, daher fehlen einige Karten. Importiere ihn erneut, um ihn zu vervollständigen, oder lösche ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deck didn't finish uploading, so some cards are missing. Import it again to complete it, or delete it."
