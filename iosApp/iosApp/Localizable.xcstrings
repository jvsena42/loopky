    "speak_failed_language_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat kein Sprachmodell für die Sprache dieses Stapels. Füge es in den Diktier-Einstellungen deines Geräts hinzu."
          }
        },
        "en": {
          "stringUnit": {
