    "bulk_error_unreadable_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky konnte sie nicht lesen. Versuch, sie nochmal auszuwählen, oder kopiere sie zuerst an einen anderen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky couldn't read it. Try picking it again, or copy it somewhere else first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky no pudo leerlo. Intenta elegirlo de nuevo, o primero cópialo a otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky n’a pas pu le lire. Essaie de le choisir à nouveau, ou copie-le d’abord ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky non è riuscito a leggerlo. Prova a sceglierlo di nuovo, oppure copialo prima da un'altra parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky はこのファイルを読み込めませんでした。もう一度選ぶか、先に別の場所にコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky가 파일을 읽지 못했어요. 다시 선택하거나, 먼저 다른 곳에 복사해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky não conseguiu lê-lo. Tente escolhê-lo de novo, ou copie-o para outro lugar primeiro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky không đọc được tệp. Hãy thử chọn lại, hoặc sao chép tệp sang nơi khác trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 无法读取它。请重新选择一次，或先把它复制到其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky 無法讀取它。請再選一次，或先把它複製到其他地方。"
          }
        }
      }
    },
