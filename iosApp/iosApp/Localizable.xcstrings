    "signup_lightning_resumed_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht hast du ₿ %1$lld schon bezahlt. Warte, während wir das bestätigen, und zahle nicht noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may already have paid ₿ %1$lld. Hold on while we confirm, and don't pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que ya hayas pagado ₿ %1$lld. Espera mientras lo confirmamos, y no vuelvas a pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as peut-être déjà payé ₿ %1$lld. Patiente pendant qu’on confirme, et ne paie pas une deuxième fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti aver già pagato ₿ %1$lld. Attendi mentre confermiamo e non pagare di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode já ter pago ₿ %1$lld. Aguarde enquanto confirmamos, e não pague de novo."
          }
        }
      }
    },
