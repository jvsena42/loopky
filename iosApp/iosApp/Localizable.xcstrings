    "bulk_error_unreadable_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky konnte sie nicht lesen. Versuch, sie nochmal auszuwählen, oder kopiere sie zuerst an einen anderen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky couldn't read it. Try picking it again, or copy it somewhere else first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky no pudo leerlo. Intenta elegirlo de nuevo, o primero cópialo a otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky n’a pas pu le lire. Essaie de le choisir à nouveau, ou copie-le d’abord ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky non è riuscito a leggerlo. Prova a sceglierlo di nuovo, oppure copialo prima da un'altra parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky não conseguiu lê-lo. Tente escolhê-lo de novo, ou copie-o para outro lugar primeiro."
          }
        }
      }
    },
