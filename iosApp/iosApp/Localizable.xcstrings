    "deck_detail_delete_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und alles, was du damit gelernt hast, werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and everything you've learned from it will be deleted. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán “%1$@” y todo lo que has aprendido con él. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et tout ce que tu y as appris seront supprimés. C’est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tutto quello che hai imparato con questo mazzo verranno eliminati. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」とその学習記録がすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” 덱과 지금까지의 학습 기록이 모두 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tudo o que você aprendeu com ele serão excluídos. Isso não pode ser desfeito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” cùng mọi thứ bạn đã học từ bộ thẻ này sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”以及你从中学到的一切都将被删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」以及你從中學到的一切都會被刪除。此動作無法復原。"
          }
        }
      }
    },
