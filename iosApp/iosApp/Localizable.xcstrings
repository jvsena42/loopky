    "backup_method_file_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine passphrasengeschützte Datei in Dateien oder iCloud Drive."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a passphrase-protected file to Files or iCloud Drive."
