    "discover_empty_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Freunde über ihren pubky hinzu, um ihnen zu folgen und ihre öffentlichen Stapel zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a friend by their pubky to follow them and see their public decks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a alguien con su pubky para seguirlo y ver sus mazos públicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une personne avec son pubky pour la suivre et voir ses paquets publics."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una persona tramite il suo pubky per seguirla e vedere i suoi mazzi pubblici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちの pubky で追加すると、フォローして公開デッキを見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pubky로 친구를 추가해 팔로우하고 공개 덱을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um amigo pelo pubky dele para segui-lo e ver seus baralhos públicos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một người bạn bằng pubky của họ để theo dõi và xem các bộ thẻ công khai của họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过好友的 pubky 添加并关注他们，就能看到他们的公开卡组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入朋友的 pubky 來追蹤對方，並查看他們的公開牌組。"
          }
        }
      }
    },
