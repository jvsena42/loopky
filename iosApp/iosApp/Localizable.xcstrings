    "study_goal_reached_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein Ziel für heute. Nichts ist gesperrt, also mach ruhig weiter, wenn du gerade gut dabei bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's your target for today. Nothing is locked, so keep going if you're on a roll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es tu meta de hoy. No hay nada bloqueado, así que sigue si estás en racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ton objectif du jour. Rien n’est bloqué, alors continue si tu es sur ta lancée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo obiettivo di oggi. Non si blocca nulla, quindi continua se sei in vena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の目標はクリアです。制限はないので、調子が良ければそのまま続けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 목표를 채웠어요. 잠긴 건 없으니 흐름을 탔다면 계속해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa é a sua meta de hoje. Nada fica bloqueado, então continue se estiver embalado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt chỉ tiêu hôm nay. Không có gì bị khóa cả, cứ học tiếp nếu bạn đang hăng say."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的目标完成了。没有任何限制，状态好的话就继续学吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你今天的目標。沒有任何東西被鎖住，如果學得正起勁，就繼續吧。"
          }
        }
      }
    },
