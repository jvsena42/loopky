    "paste_validation_no_cards": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Karten gefunden. Prüfe das Trennzeichen oder füge eine Vorder- und Rückseite hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cards found yet. Check the separator, or add a front and back."
          }
        },
        "es": {
