    "pubky_app_cta_body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel, mit dem du dich angemeldet hast, ist ein Pubky-Konto. Sieh dir dein Profil und deine Beiträge im Web an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key you signed in with is a Pubky account. See your profile and posts on the web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave con la que iniciaste sesión es una cuenta de Pubky. Mira tu perfil y tus publicaciones en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé utilisée pour ta connexion est un compte Pubky. Retrouve ton profil et tes publications sur le web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave con cui hai effettuato l'accesso è un account Pubky. Guarda il tuo profilo e i tuoi post sul web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに使った鍵は Pubky アカウントです。ウェブでプロフィールや投稿を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 키는 Pubky 계정이에요. 웹에서 내 프로필과 게시물을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave com que você entrou é uma conta Pubky. Veja seu perfil e suas publicações na web."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bạn dùng để đăng nhập là một tài khoản Pubky. Xem hồ sơ và bài đăng của bạn trên web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你登录所用的密钥就是一个 Pubky 账号。可以在网页上查看你的个人主页和帖子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你登入時使用的金鑰就是一個 Pubky 帳號。在網頁上查看你的個人檔案和貼文。"
          }
        }
      }
    },
