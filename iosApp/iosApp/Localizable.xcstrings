    "backup_file_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Passphrase. Zum Wiederherstellen brauchst du sie und die Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a passphrase. You will need it, and the file, to restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una contraseña. La necesitarás, junto con el archivo, para restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un mot de passe. Tu en auras besoin, avec le fichier, pour restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una password. Per ripristinare ti serviranno sia la password sia il file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズを決めてください。復元にはこのパスフレーズとファイルの両方が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호를 정하세요. 복원하려면 이 암호와 파일이 모두 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma senha. Você vai precisar dela, e do arquivo, para restaurar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một cụm mật khẩu. Bạn sẽ cần nó, cùng với tệp, để khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置一个密码短语。恢复时你需要它和这个文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定一組密碼短語。還原時需要它和這個檔案。"
          }
        }
      }
    },
