    "backup_start_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel existiert nur auf diesem Gerät. Speichere ihn an einem Ort, an den du auch ohne dein Handy kommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key lives only on this device. Save it somewhere you can reach if you lose your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave solo existe en este dispositivo. Guárdala en algún lugar al que puedas acceder si pierdes el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta clé n’existe que sur cet appareil. Garde-la dans un endroit accessible si tu perds ton téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave esiste solo su questo dispositivo. Salvala in un posto che puoi raggiungere anche se perdi il telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave existe só neste aparelho. Guarde-a em algum lugar que você alcance se perder o celular."
          }
        }
      }
    },
    "backup_start_subtitle_backed_up": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast schon eine Kopie dieses Schlüssels. Pubky Ring bewahrt ihn in einer separaten App auf, was noch sicherer ist, oder du fügst hier ein weiteres Backup hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a copy of this key. Pubky Ring keeps it in a separate app, which is safer still, or you can add another backup here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes una copia de esta clave. Pubky Ring la guarda en una app aparte, lo que es aún más seguro, o puedes añadir otra copia de seguridad aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà une copie de cette clé. Pubky Ring la garde dans une app séparée, ce qui est encore plus sûr, ou tu peux ajouter une autre sauvegarde ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già una copia di questa chiave. Pubky Ring la tiene in un'app separata, che è ancora più sicuro, oppure puoi aggiungere un altro backup qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tem uma cópia desta chave. O Pubky Ring a guarda em um app separado, o que é ainda mais seguro, ou você pode adicionar outro backup aqui."
          }
        }
      }
    },
