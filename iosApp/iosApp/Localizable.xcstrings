    "speak_failed_language_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat kein Sprachmodell für die Sprache dieses Stapels. Füge es in den Diktier-Einstellungen deines Geräts hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no speech model for this deck’s language. Add it in your device’s dictation settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene un modelo de voz para el idioma de este mazo. Añádelo en la configuración de dictado de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de modèle vocal pour la langue de ce paquet. Ajoute-le dans les réglages de dictée de ton appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un modello vocale per la lingua di questo mazzo. Aggiungilo nelle impostazioni di dettatura del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには、このデッキの言語の音声モデルがありません。デバイスの音声入力設定で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 이 덱의 언어에 맞는 음성 모델이 없어요. 기기의 받아쓰기 설정에서 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem um modelo de fala para o idioma deste baralho. Adicione nas configurações de ditado do aparelho."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không có mô hình giọng nói cho ngôn ngữ của bộ thẻ. Hãy thêm trong cài đặt đọc chính tả của thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有这个卡组语言的语音模型。请在设备的听写设置中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置沒有這個牌組語言的語音模型。請到裝置的聽寫設定中新增。"
          }
        }
      }
    },
