    "deck_detail_clone_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du bekommst eine bearbeitbare Kopie dieser %1$lld Karte. Sie erhält keine Updates vom Original mehr, und dein Fortschritt beginnt von vorn."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Du bekommst eine bearbeitbare Kopie aller %1$lld Karten. Sie erhält keine Updates vom Original mehr, und dein Fortschritt beginnt von vorn."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You'll own an editable copy of this %1$lld card. It won't get the author's updates, and your progress starts over."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "You'll own an editable copy of all %1$lld cards. It won't get the author's updates, and your progress starts over."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tendrás una copia editable con %1$lld de tarjetas. No recibirá las actualizaciones del autor, y tu progreso empieza de cero."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tendrás una copia editable con %1$lld tarjeta. No recibirá las actualizaciones del autor, y tu progreso empieza de cero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tendrás una copia editable con las %1$lld tarjetas. No recibirá las actualizaciones del autor, y tu progreso empieza de cero."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu auras une copie modifiable de ce paquet de %1$lld de cartes. Elle ne recevra pas les mises à jour de l’auteur, et ta progression repart de zéro."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu auras une copie modifiable de ce paquet de %1$lld carte. Elle ne recevra pas les mises à jour de l’auteur, et ta progression repart de zéro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu auras une copie modifiable de ce paquet de %1$lld cartes. Elle ne recevra pas les mises à jour de l’auteur, et ta progression repart de zéro."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avrai una copia modificabile di tutti i %1$lld di carte. Non riceverà gli aggiornamenti dell'autore e i tuoi progressi ripartono da zero."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avrai una copia modificabile di questa carta (%1$lld). Non riceverà gli aggiornamenti dell'autore e i tuoi progressi ripartono da zero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avrai una copia modificabile di tutte le %1$lld carte. Non riceverà gli aggiornamenti dell'autore e i tuoi progressi ripartono da zero."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Você terá uma cópia editável desta %1$lld carta. Ela não recebe as atualizações do autor, e seu progresso recomeça."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Você terá uma cópia editável das %1$lld cartas. Ela não recebe as atualizações do autor, e seu progresso recomeça."
                }
              }
            }
          }
        }
      }
    },
