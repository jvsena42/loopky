    "bulk_format_text_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: Datei → Exportieren → „Notizen als reiner Text“. Jede durch Tabulatoren oder Kommas getrennte Liste funktioniert auch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: File → Export → “Notes in Plain Text”. Any tab- or comma-separated list works too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Anki: Archivo → Exportar → “Notas en texto plano”. También sirve cualquier lista separada por tabulaciones o comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Anki : Fichier → Exporter → « Notes en texte brut ». Toute liste séparée par des tabulations ou des virgules fonctionne aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Anki: File → Esporta → “Note in testo semplice”. Va bene anche qualsiasi lista separata da tabulazioni o virgole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Anki: Arquivo → Exportar → “Notas em texto puro”. Qualquer lista separada por tabulação ou vírgula também funciona."
          }
        }
      }
    },
