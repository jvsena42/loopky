    "discover_empty_tag_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand hat einen Stapel damit getaggt. Tippe nochmal auf das Tag, um alles zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody has tagged a deck with this yet. Tap the tag again to see everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie ha etiquetado un mazo con esto todavía. Toca la etiqueta otra vez para ver todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’a encore mis ce tag sur un paquet. Touche à nouveau le tag pour tout voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha ancora usato questo tag su un mazzo. Tocca di nuovo il tag per vedere tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグが付いたデッキはまだありません。タグをもう一度タップすると、すべて表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이 태그를 단 덱이 없어요. 태그를 다시 탭하면 전체를 볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém marcou um baralho com isso ainda. Toque na tag de novo para ver tudo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ai gắn nhãn này cho bộ thẻ nào. Nhấn lại vào nhãn để xem tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有人用这个标签标记卡组。再点一次该标签即可查看全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有人用這個標籤標記牌組。再點一次標籤即可查看全部。"
          }
        }
      }
