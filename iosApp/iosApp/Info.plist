			<string>com.github.jvsena42.loopky.apkg</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apkg</string>
				</array>
			</dict>
		</dict>
	</array>
