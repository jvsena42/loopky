{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky nutzt die Kamera, um einen QR-Code mit dem pubky einer Person zu lesen, damit du sie ohne Tippen findest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky uses the camera to read a QR code holding someone's pubky, so you can find them without typing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky usa la cámara para leer un código QR con el pubky de alguien, para que puedas encontrar a esa persona sin escribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky utilise l’appareil photo pour lire un code QR contenant le pubky de quelqu’un, pour que tu le trouves sans avoir à le saisir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky usa a câmera para ler um código QR com o pubky de alguém, para você encontrar essa pessoa sem digitar nada."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky hört zu, während du übst, eine Karte laut auszusprechen, und hört auf, sobald du geantwortet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky listens while you practise saying a card out loud, and stops as soon as you have answered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky te escucha mientras practicas decir una tarjeta en voz alta, y se detiene en cuanto respondes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky écoute pendant que tu t’entraînes à dire une carte à voix haute, et s’arrête dès que tu as répondu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky escuta enquanto você pratica dizer uma carta em voz alta, e para assim que você responde."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky wandelt, was du sagst, in Text um, um deine Aussprache mit der Karte abzugleichen. Es wird nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky turns what you say into text to check your pronunciation against the card. Nothing is stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky convierte lo que dices en texto para comparar tu pronunciación con la tarjeta. No se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopky transforme ce que tu dis en texte pour comparer ta prononciation à la carte. Rien n’est conservé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Loopky transforma o que você diz em texto para conferir sua pronúncia com a carta. Nada é armazenado."
          }
        }
      }
    }
  },
  "version": "1.0"
}
